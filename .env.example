# Frontend build-time environment variables (Vite bakes these into the
# built bundle at build time, not read at runtime -- rebuild after
# changing any of these).

# Point this at the marketplace-backend Railway service's public URL
VITE_API_URL=https://your-marketplace-backend.up.railway.app

# Google/Facebook sign-in — public identifiers, safe to bake into the
# client bundle (never a secret). Each button only renders once its own
# var is set; leave blank to keep both hidden. Must match the backend's
# GOOGLE_CLIENT_ID / FACEBOOK_APP_ID (server/.env.example) -- same
# values, this is just the frontend-exposed copy of each.
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=
