# Backend environment variables
#
# Copy this file to .env for local development (docker-compose.yml reads
# from it automatically). In Railway, these are set on the
# ballylife-backend service's Variables tab, not in a committed file.
# This file documents every process.env.X the backend actually reads --
# grepped from source, not written from memory -- so it stays accurate
# as the real reference for "what does this app need to run."

# ── Required ──────────────────────────────────────────────────────────────

# Postgres connection string. docker-compose.yml wires this to the local
# postgres service automatically; in Railway it's a reference variable
# (${{Postgres.DATABASE_URL}}), not a literal value.
DATABASE_URL=postgres://ballylife:ballylife@localhost:5432/ballylife

# Signs every marketplace JWT. Generate a real random value for anything
# beyond local dev -- e.g. `openssl rand -base64 48`. In production
# (NODE_ENV=production) the app refuses to start if this is unset, rather
# than silently falling back to an insecure default.
MARKETPLACE_JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of origins allowed to call this API (CORS). Falls
# back to localhost-only if unset, so a misconfigured deploy fails closed
# rather than open.
MARKETPLACE_ALLOWED_ORIGINS=http://localhost:5173

# ── PayFast (payments) — required for real checkout to work ────────────────
# Get these from your PayFast merchant account. PAYFAST_MODE selects
# between PayFast's sandbox and live endpoints.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_MODE=sandbox

# Public URLs PayFast redirects/posts back to after checkout. In local
# dev these won't be reachable from PayFast's servers (only matters once
# testing a real PayFast round-trip, not for general local development).
MARKETPLACE_PUBLIC_URL=http://localhost:5173
MARKETPLACE_API_PUBLIC_URL=http://localhost:3001

# ── Optional — features degrade gracefully without these ───────────────────

# Node environment. Only real effect right now: in "production", a
# missing MARKETPLACE_JWT_SECRET throws at startup instead of falling
# back to a dev default.
NODE_ENV=development

# Port the server listens on.
PORT=3001

# Set to "true" if your Postgres requires SSL (Railway's does; a local
# docker-compose Postgres does not).
PGSSL=false

# SMTP — password-reset and order-confirmation emails. Without these set,
# isEmailConfigured() returns false and those features no-op rather than
# error.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Ballylife <no-reply@ballylife.example>

# CJdropshipping — real product sourcing. Without these, the admin
# "Sync from CJdropshipping" action returns a clean 503 rather than
# failing; nothing else in the app depends on this being set.
# CJ_EMAIL is the email on your CJdropshipping account; CJ_API_KEY is
# generated from that account's settings (developers.cjdropshipping.com).
CJ_EMAIL=
CJ_API_KEY=

# Automatic order placement (services/cjFulfillment.ts). Once CJ_EMAIL and
# CJ_API_KEY are set, a worker places every paid order containing CJ items
# with CJ within about a minute, and syncs tracking back hourly.
#
# CJ_AUTO_PAY=true pays each CJ order from your CJ wallet balance the moment
# it's placed. Left unset, orders are created in CJ but UNPAID -- you pay
# them in CJ's dashboard. Run a real test order with it unset first.
CJ_AUTO_PAY=
# Set to true to create CJ sandbox orders only (no real shipment).
CJ_SANDBOX=
# Pin one carrier by CJ's exact logisticName; unset = cheapest route CJ quotes.
CJ_LOGISTIC_NAME=
# Where CJ ships from (two-letter code). Default CN.
CJ_FROM_COUNTRY=
# Carrier name customers see when CJ's own name would reveal the supplier.
WHITE_LABEL_CARRIER_NAME=Ballylife Express
# Emailed when a paid order can't be placed or CJ cancels one (needs SMTP above).
ADMIN_ALERT_EMAIL=
# Set to false to stop the worker (e.g. on a second replica).
CJ_FULFILLMENT_WORKER=

# Google/Facebook sign-in — public identifiers, not secrets. Buttons only
# render (frontend) and routes only activate (backend) once these are set;
# see VITE_GOOGLE_CLIENT_ID / VITE_FACEBOOK_APP_ID in the frontend's own
# .env.example for the matching frontend half of each.
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
